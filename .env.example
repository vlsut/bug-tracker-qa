# Copy to .env and fill in. .env is git-ignored; never commit real values.
# In CI the same names come from GitHub Secrets.

# Test user with the admin role
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=

# Test user with the user role
TEST_USER_USERNAME=
TEST_USER_PASSWORD=

# Jira export of test cases (tools/jira_export.py). Never commit the token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Optional, default: Task
JIRA_ISSUE_TYPE=
